{
  "schema_version": "1.0",
  "built_on": "2026-10-12",
  "description": "Registry of prominent design systems, mapped to the common taxonomy. Used before any website scan: if a link matches a system here and its record is fresh, use the stored data instead of scanning.",
  "taxonomy": {
    "tiers": {
      "primary": ["foundations", "layout", "actions", "forms", "navigation", "data_display", "feedback"],
      "secondary": ["overlays", "media", "patterns", "content"],
      "others": ["tooling", "miscellaneous"]
    },
    "categories": {
      "foundations": "Foundations and tokens",
      "layout": "Layout and structure",
      "actions": "Actions",
      "forms": "Forms and input",
      "navigation": "Navigation",
      "data_display": "Data display",
      "feedback": "Feedback and status",
      "overlays": "Overlays",
      "media": "Media and identity",
      "patterns": "Patterns and page templates",
      "content": "Content and voice",
      "tooling": "Utilities and tooling",
      "miscellaneous": "Catch-all for anything that fits no category"
    }
  },
  "lookup_rules": {
    "match_order": ["domain", "library_class_signals", "package_names", "name_in_page_text"],
    "use_stored_when": "a system matches AND coverage is 'mapped' AND the record is younger than ttl_days",
    "scan_when": "no match, OR coverage is 'stub', OR the record is older than ttl_days, OR the user asks for a refresh",
    "on_stub": "use the stored facts, tell the user the record is partial, and offer to research or scan the rest",
    "on_stale": "use the stored data now, tell the user how old it is, and offer a refresh",
    "on_no_match": "run the website process: ask the user before extracting a derived design system",
    "ttl_days": 180
  },
  "systems": [
