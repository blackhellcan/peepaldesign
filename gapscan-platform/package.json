{
  "name": "gapscan-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "dev": "node --env-file-if-exists=.env --watch apps/api/src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@electric-sql/pglite-socket": "0.2.13",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "typescript": "^5.9.0"
  }
}
